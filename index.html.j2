<header class="site-header">
  <div class="wrap">
    <a class="brand" href="https://www.nx-ai.com" aria-label="NXAI website">
      <svg viewBox="0 0 1559.1 474.5" role="img" aria-label="NXAI"><path fill-rule="evenodd" d="M1248,1.1h-54.3l-194,390.3,40.8,52,179.5-365,183,394.9h66.4L1248,1.1ZM1500.8,473.3h58.3V1.2h-58.3v472ZM989.5,1.5l-141.3,189.2-76.8-99.9L835.9,1.5h153.6ZM850,263.8l161.9,209.3h-155.5l-82.4-106.5,76-102.8ZM646.6,1.4l174.6,226.2-181.9,245.7h-161.4l190.5-249.2L497.7,1.4h148.8ZM315.8,1.5h129.3v471.9h-114.5L129.3,214.4v258.9H0V1.4h121.9l193.9,249.4V1.5h0Z"/></svg>
    </a>
    <div class="header-right">
      <nav class="nav" aria-label="Main">
        <a href="#projects">Projects</a>
        <a href="#documentation">Documentation</a>
        <a href="https://nx-ai.github.io/linktree/">Publications</a>
        <a href="https://github.com/NX-AI">GitHub</a>
        <a href="https://huggingface.co/NX-AI">Hugging Face</a>
      </nav>
      <div class="theme-toggle" role="group" aria-label="Colour theme">
        <button type="button" data-theme-btn="dark" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-moon"/></svg>Dark</button>
        <button type="button" data-theme-btn="light" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-sun"/></svg>Light</button>
      </div>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="hero" aria-labelledby="hero-title">
    <div class="tag">PUBLIC REPOSITORIES</div>
    <h1 id="hero-title">Code and models from NXAI</h1>
    <p>Source code, pretrained models and documentation for xLSTM and TiRex, released by NXAI GmbH, Linz, Austria. Each project links to its repository, paper and, where available, documentation and packages.</p>
  </section>

  <section id="documentation" aria-labelledby="docs-title">
    <div class="section-head">
      <div class="tag">DOCUMENTATION AND RESOURCES</div>
      <h2 id="docs-title">Documentation sites</h2>
    </div>
    <div class="doc-grid">
      {%- for d in documentation %}
      <a class="doc-card" href="{{ d.url }}">
        <span class="doc-title"><svg class="icon" aria-hidden="true"><use href="#i-{{ d.icon }}"/></svg>{{ d.title }}</span>
        <span class="doc-body">{{ d.description }}</span>
        <span class="doc-url">{{ d.display_url }} ↗</span>
      </a>
      {%- endfor %}
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <div class="projects-head">
      <div class="section-head">
        <div class="tag">REPOSITORIES</div>
        <h2 id="projects-title">Projects</h2>
      </div>
      <div class="filters" role="group" aria-label="Filter projects by area" hidden>
        <button type="button" data-filter="all" aria-pressed="true">All ({{ total }})</button>
        {%- for g in groups %}
        <button type="button" data-filter="{{ g.id }}" aria-pressed="false">{{ g.title }}</button>
        {%- endfor %}
      </div>
    </div>

    {%- for g in groups %}
    <div class="group" data-group="{{ g.id }}">
      <div class="group-head">
        <h3>{{ g.title }}</h3>
        <span class="count">{{ g.projects | length }} {{ "repository" if g.projects | length == 1 else "repositories" }}</span>
      </div>
      <div class="grid">
        {%- for p in g.projects %}
        <article class="card">
          <div class="card-head">
            <div class="card-title">
              <h4>{{ p.name }}</h4>
              <span class="repo">{{ p.repo }}</span>
            </div>
            {%- if p.stars %}
            <span class="stars"><svg class="icon" aria-hidden="true"><use href="#i-star"/></svg>{{ p.stars }}<span class="sr-only"> GitHub stars</span></span>
            {%- endif %}
          </div>
          <p class="desc">{{ p.description }}</p>
          <div class="meta">
            <span class="venue venue-{{ p.venue.conf | lower }}">{{ p.venue_label }}</span>
            <span class="license"><svg class="icon" aria-hidden="true"><use href="#i-scale"/></svg><span><span class="sr-only">Licence: </span>{{ p.license }}</span></span>
          </div>
          {%- if p.install %}
          <code class="install">{{ p.install }}</code>
          {%- endif %}
          <div class="links">
            {%- for l in p.links %}
            <a href="{{ l.url }}"><svg class="icon {{ l.icon }}" aria-hidden="true"><use href="#{{ l.icon }}"/></svg>{{ l.label }}</a>
            {%- endfor %}
          </div>
        </article>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </section>
</main>

