  <symbol id="i-scale" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M7 21h10M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/><path d="M2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/></g></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></g></symbol>
</svg>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="https://www.nx-ai.com" aria-label="NXAI website">
      <svg viewBox="0 0 1559.1 474.5" role="img" aria-label="NXAI"><path fill-rule="evenodd" d="M1248,1.1h-54.3l-194,390.3,40.8,52,179.5-365,183,394.9h66.4L1248,1.1ZM1500.8,473.3h58.3V1.2h-58.3v472ZM989.5,1.5l-141.3,189.2-76.8-99.9L835.9,1.5h153.6ZM850,263.8l161.9,209.3h-155.5l-82.4-106.5,76-102.8ZM646.6,1.4l174.6,226.2-181.9,245.7h-161.4l190.5-249.2L497.7,1.4h148.8ZM315.8,1.5h129.3v471.9h-114.5L129.3,214.4v258.9H0V1.4h121.9l193.9,249.4V1.5h0Z"/></svg>
    </a>
    <div class="header-right">
      <nav class="nav" aria-label="Main">
        <a href="#projects">Projects</a>
        <a href="#documentation">Documentation</a>
        {%- if star_total or download_total or hf_total %}
        <a href="#statistics">Statistics</a>
        {%- endif %}
        <a href="https://nx-ai.github.io/linktree/">Publications</a>
        <a href="https://github.com/NX-AI">GitHub</a>
        <a href="https://huggingface.co/NX-AI">Hugging Face</a>
      </nav>
      <div class="theme-toggle" role="group" aria-label="Colour theme">
        <button type="button" data-theme-btn="dark" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-moon"/></svg>Dark</button>
        <button type="button" data-theme-btn="light" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-sun"/></svg>Light</button>
      </div>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="hero" aria-labelledby="hero-title">
    <div class="tag">PUBLIC REPOSITORIES</div>
    <h1 id="hero-title">Code and models from NXAI</h1>
    <p>Source code, pretrained models and documentation for xLSTM and TiRex, released by NXAI GmbH, Linz, Austria. Each project links to its repository, paper and, where available, documentation and packages.</p>
  </section>

  <section id="documentation" aria-labelledby="docs-title">
    <div class="section-head">
      <div class="tag">DOCUMENTATION AND RESOURCES</div>
      <h2 id="docs-title">Documentation sites</h2>
    </div>
    <div class="doc-grid">
      {%- for d in documentation %}
      <a class="doc-card" href="{{ d.url }}">
        <span class="doc-title"><svg class="icon" aria-hidden="true"><use href="#i-{{ d.icon }}"/></svg>{{ d.title }}</span>
        <span class="doc-body">{{ d.description }}</span>
        <span class="doc-url">{{ d.display_url }} ↗</span>
      </a>
      {%- endfor %}
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <div class="projects-head">
      <div class="section-head">
        <div class="tag">REPOSITORIES</div>
        <h2 id="projects-title">Projects</h2>
      </div>
      <div class="filters" role="group" aria-label="Filter projects by area" hidden>
        <button type="button" data-filter="all" aria-pressed="true">All ({{ total }})</button>
        {%- for g in groups %}
        <button type="button" data-filter="{{ g.id }}" aria-pressed="false">{{ g.title }}</button>
        {%- endfor %}
      </div>
    </div>

    {%- for g in groups %}
    <div class="group" data-group="{{ g.id }}">
      <div class="group-head">
        <h3>{{ g.title }}</h3>
        <span class="count">{{ g.projects | length }} {{ "repository" if g.projects | length == 1 else "repositories" }}</span>
      </div>
      <div class="grid">
        {%- for p in g.projects %}
        <article class="card">
          <div class="card-head">
            <div class="card-title">
              <h4>{{ p.name }}</h4>
              <span class="repo">{{ p.repo }}</span>
            </div>
            {%- if p.stars or p.downloads or p.hf_downloads %}
            <div class="stats">
              {%- if p.stars %}
              <span class="stars"><svg class="icon" aria-hidden="true"><use href="#i-star"/></svg>{{ p.stars }}<span class="sr-only"> GitHub stars</span></span>
              {%- endif %}
              {%- if p.downloads %}
              <span class="stars" title="PyPI downloads, all time"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>{{ p.downloads }}<span class="src" aria-hidden="true">PyPI</span><span class="sr-only"> PyPI downloads, all time</span></span>
              {%- endif %}
              {%- if p.hf_downloads %}
              <span class="stars" title="Hugging Face model downloads, all time"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>{{ p.hf_downloads }}<span class="src" aria-hidden="true">HF</span><span class="sr-only"> Hugging Face model downloads, all time</span></span>
              {%- endif %}
            </div>
            {%- endif %}
          </div>
          <p class="desc">{{ p.description }}</p>
          <div class="meta">
            <span class="venue venue-{{ p.venue.conf | lower }}">{{ p.venue_label }}</span>
            <span class="license"><svg class="icon" aria-hidden="true"><use href="#i-scale"/></svg><span><span class="sr-only">Licence: </span>{{ p.license }}</span></span>
          </div>
          {%- if p.install %}
          <div class="install-box">
            <code class="install">{{ p.install }}</code>
            <button type="button" class="copy-btn" title="Copy to clipboard" aria-label="Copy {{ p.install }}" hidden><svg class="icon i-copy" aria-hidden="true"><use href="#i-copy"/></svg><svg class="icon i-done" aria-hidden="true"><use href="#i-check"/></svg></button>
          </div>
          {%- endif %}
          <div class="links">
            {%- for l in p.links %}
            <a href="{{ l.url }}"><svg class="icon {{ l.icon }}" aria-hidden="true"><use href="#{{ l.icon }}"/></svg>{{ l.label }}</a>
            {%- endfor %}
          </div>
        </article>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </section>

  {%- if star_total or download_total or hf_total %}
  <section id="statistics" class="stats-section" aria-labelledby="stats-title">
    <div class="section-head">
      <div class="tag">USAGE</div>
      <h2 id="stats-title">Statistics</h2>
    </div>
    <div class="stat-tiles">
      {%- if star_total %}
      <div class="tile"><span class="tile-value">{{ star_total }}</span><span class="tile-label">GitHub stars across {{ total }} repositories</span></div>
      {%- endif %}
      {%- if download_total %}
      <div class="tile"><span class="tile-value">{{ download_total }}</span><span class="tile-label">PyPI downloads, all time</span><span class="tile-note">{{ download_recent or "0" }} in the last 30 days</span></div>
      {%- endif %}
      {%- if hf_total %}
      <div class="tile"><span class="tile-value">{{ hf_total }}</span><span class="tile-label">Hugging Face model downloads, all time</span><span class="tile-note">{{ hf_recent }} in the last 30 days</span></div>
      {%- endif %}
    </div>

    {%- if has_charts %}
    <div class="chart-panel" hidden>
      <div class="chart-top">
        <h3 class="chart-title"></h3>
      </div>
      <div class="legend" role="group" aria-label="Show or hide series"></div>
      <div class="plot-wrap">
        <div class="plot"></div>
        <div class="chart-tip" hidden></div>
      </div>
      <p class="chart-caption"></p>
      <details class="data-table">
        <summary>Show chart data as a table</summary>
        <div class="table-scroll"><table><thead></thead><tbody></tbody></table></div>
      </details>
    </div>
    <script type="application/json" id="chart-data">{{ chart_json | safe }}</script>
    {%- endif %}

    <div class="stats-table-card">
      <table>
        <caption class="sr-only">Stars and all-time downloads per project, with downloads in the last 30 days below each total</caption>
        <thead>
          <tr><th scope="col">Project</th><th scope="col">GitHub stars</th><th scope="col">PyPI downloads</th><th scope="col">Hugging Face downloads</th></tr>
        </thead>
        <tbody>
          {%- for p in stat_rows %}
          <tr>
            <td>{{ p.name }}<span class="repo">{{ p.repo }}</span></td>
            <td>{{ p.stars or "0" }}</td>
            <td>{% if p.downloads %}{{ p.downloads }}<span class="sub">{{ p.downloads_recent or "0" }} last 30 days</span>{% else %}<span class="na">–</span>{% endif %}</td>
            <td>{% if p.has_hf %}{{ p.hf_downloads_all }}<span class="sub">{{ p.hf_downloads_recent }} last 30 days</span>{% else %}<span class="na">–</span>{% endif %}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {%- endif %}
</main>

