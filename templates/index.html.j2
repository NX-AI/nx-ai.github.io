<div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>

<script>
  (function () {
    var root = document.documentElement;
    var themeBtns = document.querySelectorAll("[data-theme-btn]");
    function syncTheme() {
      var t = root.getAttribute("data-theme");
      themeBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.themeBtn === t)); });
    }
    themeBtns.forEach(function (b) {
      b.addEventListener("click", function () {
        root.setAttribute("data-theme", b.dataset.themeBtn);
        try { localStorage.setItem("nxai-links-theme", b.dataset.themeBtn); } catch (e) {}
        syncTheme();
      });
    });
    syncTheme();

    // Copy buttons for the pip install commands; hidden without JavaScript or Clipboard API.
    var status = document.getElementById("copy-status");
    if (navigator.clipboard && window.isSecureContext) {
      document.querySelectorAll(".copy-btn").forEach(function (b) {
        var timer = null;
        b.hidden = false;
        b.addEventListener("click", function () {
          var text = b.parentNode.querySelector(".install").textContent.trim();
          navigator.clipboard.writeText(text).then(function () {
            b.classList.add("copied");
            b.title = "Copied";
            status.textContent = "Copied: " + text;
            clearTimeout(timer);
            timer = setTimeout(function () {
              b.classList.remove("copied");
              b.title = "Copy to clipboard";
              status.textContent = "";
            }, 1500);
          });
        });
      });
    }

    var filters = document.querySelector(".filters");
    var groups = document.querySelectorAll("[data-group]");
    filters.hidden = false;
    filters.querySelectorAll("button").forEach(function (b) {
      b.addEventListener("click", function () {
        var f = b.dataset.filter;
        filters.querySelectorAll("button").forEach(function (o) { o.setAttribute("aria-pressed", String(o === b)); });
        groups.forEach(function (g) { g.hidden = !(f === "all" || g.dataset.group === f); });
      });
    });
  })();

  (function () {
    var dataEl = document.getElementById("chart-data");
    var panel = document.querySelector(".chart-panel");
    if (!dataEl || !panel) return;
    var charts = JSON.parse(dataEl.textContent);
    var META = {
      downloads: { title: "PyPI downloads per week", what: "downloads", date: "Week of ",
                   caption: "Downloads per package for each complete week (Monday to Sunday). The current week is left out until it is complete." }
    };
    var NS = "http://www.w3.org/2000/svg";
    var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var titleEl = panel.querySelector(".chart-title");
    var legend = panel.querySelector(".legend");
    var plot = panel.querySelector(".plot");
    var tip = panel.querySelector(".chart-tip");
    var caption = panel.querySelector(".chart-caption");
    var thead = panel.querySelector("thead");
    var tbody = panel.querySelector("tbody");
    var current = null, hidden = {}, active = null, geo = null;

    function color(s) { return "var(--s" + (s.color === "other" ? "-other" : s.color) + ")"; }
    function full(n) { return n.toLocaleString("en-US"); }
    function compact(n) {
      if (n >= 1e6) return (n / 1e6).toFixed(n >= 1e7 ? 0 : 1).replace(/\.0$/, "") + "M";
      if (n >= 1e3) return (n / 1e3).toFixed(n >= 1e4 ? 0 : 1).replace(/\.0$/, "") + "k";
      return String(n);
    }
    function parse(iso) { var p = iso.split("-"); return { y: +p[0], m: +p[1] - 1, d: +p[2] }; }
    function longDate(iso) { var d = parse(iso); return d.d + " " + MONTHS[d.m] + " " + d.y; }
    function svg(name, attrs, parent) {
      var e = document.createElementNS(NS, name);
      for (var k in attrs) e.setAttribute(k, attrs[k]);
      if (parent) parent.appendChild(e);
      return e;
    }
    function niceStep(max) {
      var raw = max / 4, mag = Math.pow(10, Math.floor(Math.log10(raw))), n = raw / mag;
      return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * mag;
    }
    function visible() { return charts[current].series.filter(function (s) { return !hidden[current + s.key]; }); }

    function buildLegend() {
      legend.textContent = "";
      charts[current].series.forEach(function (s) {
        var b = document.createElement("button");
        b.type = "button";
        b.setAttribute("aria-pressed", String(!hidden[current + s.key]));
        var k = document.createElement("span");
        k.className = "key";
        k.style.background = color(s);
        b.appendChild(k);
        b.appendChild(document.createTextNode(s.name));
        b.addEventListener("click", function () {
          hidden[current + s.key] = !hidden[current + s.key];
          b.setAttribute("aria-pressed", String(!hidden[current + s.key]));
          draw();
        });
        legend.appendChild(b);
      });
    }

    function buildTable() {
      var c = charts[current];
      thead.textContent = "";
      tbody.textContent = "";
      var hr = document.createElement("tr");
      ["Week starting"].concat(c.series.map(function (s) { return s.name; })).forEach(function (h) {
        var th = document.createElement("th");
        th.scope = "col";
        th.textContent = h;
        hr.appendChild(th);
      });
      thead.appendChild(hr);
      for (var i = c.weeks.length - 1; i >= 0; i--) {
        var tr = document.createElement("tr");
        var td = document.createElement("td");
        td.textContent = longDate(c.weeks[i]);
        tr.appendChild(td);
        c.series.forEach(function (s) {
          var cell = document.createElement("td");
          cell.textContent = s.values[i] == null ? "–" : full(s.values[i]);
          tr.appendChild(cell);
        });
        tbody.appendChild(tr);
      }
    }

    function draw() {
      var c = charts[current], series = visible();
      var width = Math.max(plot.clientWidth, 280);
      var narrow = width < 560;
      var labelled = series.length > 0 && series.length <= 4;
      var m = { t: 12, r: labelled ? (narrow ? 96 : 140) : 12, b: 28, l: 48 };
      var height = narrow ? 260 : 320;
      var w = width - m.l - m.r, h = height - m.t - m.b, n = c.weeks.length;
      var max = 0;
      series.forEach(function (s) { s.values.forEach(function (v) { if (v != null && v > max) max = v; }); });
      var step = max > 0 ? niceStep(max) : 1, top = max > 0 ? Math.ceil(max / step) * step : 4;
      function x(i) { return m.l + (n > 1 ? (i / (n - 1)) * w : w / 2); }
      function y(v) { return m.t + h - (v / top) * h; }
      geo = { x: x, y: y, m: m, w: w, h: h, n: n, series: series };

      plot.textContent = "";
      var root = svg("svg", { width: width, height: height, viewBox: "0 0 " + width + " " + height, tabindex: "0",
                              role: "img", "aria-label": META[current].title + ". Use the arrow keys to read values, or open the data table below." }, plot);
      var grid = svg("g", {}, root);
      for (var v = 0; v <= top + 1e-9; v += step) {
        svg("line", { x1: m.l, x2: m.l + w, y1: y(v), y2: y(v), stroke: v === 0 ? "var(--border2)" : "var(--border)", "stroke-width": 1 }, grid);
        var tl = svg("text", { x: m.l - 8, y: y(v) + 4, "text-anchor": "end", "font-size": 12, fill: "var(--grey)", style: "font-variant-numeric: tabular-nums" }, grid);
        tl.textContent = compact(v);
      }
      // Month ticks, thinned to fit the width.
      var span = n / 4.35, every = [1, 2, 3, 6, 12].filter(function (k) { return span / k <= w / 70; })[0] || 12;
      var lastM = -1;
      c.weeks.forEach(function (iso, i) {
        var d = parse(iso), key = d.y * 12 + d.m;
        if (key === lastM) return;
        lastM = key;
        if (i === 0 || d.m % every !== 0) return;
        var t = svg("text", { x: x(i), y: m.t + h + 18, "text-anchor": "middle", "font-size": 12, fill: "var(--grey)" }, grid);
        t.textContent = d.m === 0 || every === 12 ? String(d.y) : MONTHS[d.m];
      });

      var lines = svg("g", {}, root);
      series.forEach(function (s) {
        var dpath = "", pen = false;
        s.values.forEach(function (v, i) {
          if (v == null) { pen = false; return; }
          dpath += (pen ? "L" : "M") + x(i).toFixed(1) + " " + y(v).toFixed(1);
          pen = true;
        });
        svg("path", { d: dpath, fill: "none", stroke: color(s), "stroke-width": 2, "stroke-linejoin": "round", "stroke-linecap": "round" }, lines);
      });

      if (labelled) {
        var labels = series.map(function (s) {
          var last = s.values.length - 1;
          while (last >= 0 && s.values[last] == null) last--;
          return { s: s, y: last >= 0 ? y(s.values[last]) : m.t + h };
        }).sort(function (a, b) { return a.y - b.y; });
        for (var k = 1; k < labels.length; k++) labels[k].y = Math.max(labels[k].y, labels[k - 1].y + 16);
        var over = labels.length ? labels[labels.length - 1].y - (m.t + h) : 0;
        if (over > 0) labels.forEach(function (l) { l.y -= over; });
        labels.forEach(function (l) {
          svg("line", { x1: m.l + w + 8, x2: m.l + w + 18, y1: l.y, y2: l.y, stroke: color(l.s), "stroke-width": 2, "stroke-linecap": "round" }, root);
          var t = svg("text", { x: m.l + w + 24, y: l.y + 4, "font-size": 12, fill: "var(--soft)" }, root);
          t.textContent = l.s.name.length > 18 && narrow ? l.s.name.slice(0, 11) + "…" : l.s.name;
        });
      }

      var hover = svg("g", { visibility: "hidden" }, root);
      geo.cross = svg("line", { y1: m.t, y2: m.t + h, stroke: "var(--grey)", "stroke-width": 1 }, hover);
      geo.dots = series.map(function (s) { return svg("circle", { r: 4, fill: color(s), stroke: "var(--card)", "stroke-width": 2 }, hover); });
      geo.hover = hover;
      var hit = svg("rect", { x: m.l, y: 0, width: w, height: m.t + h, fill: "transparent" }, root);
      hit.addEventListener("pointermove", function (e) {
        var r = root.getBoundingClientRect();
        show(Math.round(((e.clientX - r.left - m.l) / w) * (n - 1)));
      });
      hit.addEventListener("pointerleave", hide);
      root.addEventListener("focus", function () { show(active == null ? n - 1 : active); });
      root.addEventListener("blur", hide);
      root.addEventListener("keydown", function (e) {
        var i = active == null ? n - 1 : active;
        if (e.key === "ArrowLeft") i -= 1;
        else if (e.key === "ArrowRight") i += 1;
        else if (e.key === "Home") i = 0;
        else if (e.key === "End") i = n - 1;
        else return;
        e.preventDefault();
        show(i);
      });
      if (active != null) show(active);
    }

    function show(i) {
      var g = geo, c = charts[current];
      i = Math.max(0, Math.min(g.n - 1, i));
      active = i;
      g.hover.setAttribute("visibility", "visible");
      g.cross.setAttribute("x1", g.x(i));
      g.cross.setAttribute("x2", g.x(i));
      var rows = [];
      g.series.forEach(function (s, k) {
        var v = s.values[i];
        g.dots[k].setAttribute("visibility", v == null ? "hidden" : "visible");
        if (v == null) return;
        g.dots[k].setAttribute("cx", g.x(i));
        g.dots[k].setAttribute("cy", g.y(v));
        rows.push({ s: s, v: v });
      });
      rows.sort(function (a, b) { return b.v - a.v; });
      tip.textContent = "";
      var head = document.createElement("div");
      head.className = "tip-date";
      head.textContent = META[current].date + longDate(c.weeks[i]);
      tip.appendChild(head);
      if (!rows.length) {
        var none = document.createElement("div");
        none.className = "tip-row";
        none.textContent = "No data";
        tip.appendChild(none);
      }
      rows.forEach(function (r) {
        var row = document.createElement("div");
        row.className = "tip-row";
        var key = document.createElement("span");
        key.className = "key";
        key.style.background = color(r.s);
        var val = document.createElement("strong");
        val.textContent = full(r.v);
        var name = document.createElement("span");
        name.className = "name";
        name.textContent = r.s.name;
        row.appendChild(key);
        row.appendChild(val);
        row.appendChild(name);
        tip.appendChild(row);
      });
      tip.hidden = false;
      var px = g.x(i), pw = plot.clientWidth, tw = tip.offsetWidth;
      var left = px + 14 + tw > pw ? px - 14 - tw : px + 14;
      tip.style.left = Math.max(0, left) + "px";
      tip.style.top = g.m.t + "px";
    }

    function hide() {
      active = null;
      tip.hidden = true;
      if (geo) geo.hover.setAttribute("visibility", "hidden");
    }

    function select(name) {
      current = name;
      active = null;
      tip.hidden = true;
      titleEl.textContent = META[name].title;
      caption.textContent = META[name].caption;
      buildLegend();
      buildTable();
      draw();
    }

    if (!charts.downloads) return;
    panel.hidden = false;
    select("downloads");
    if (window.ResizeObserver) {
      var lastW = plot.clientWidth;
      new ResizeObserver(function () {
        if (plot.clientWidth !== lastW) { lastW = plot.clientWidth; draw(); }
      }).observe(plot);
    }
  })();
</script>
</body>
</html>
