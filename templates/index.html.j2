<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Code and models from NXAI</title>
<meta name="description" content="Source code, pretrained models and documentation for xLSTM and TiRex, released by NXAI GmbH.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%23111111'/%3E%3Ctext x='12' y='17' font-family='system-ui,sans-serif' font-size='14' font-weight='700' fill='%235BFFE6' text-anchor='middle'%3EN%3C/text%3E%3C/svg%3E">
<link rel="canonical" href="https://nx-ai.github.io/">
<script>
  /* Same key as the linktree (same origin), so the theme choice carries over between both pages. */
  (function () {
    var t = null;
    try { t = localStorage.getItem("nxai-links-theme"); } catch (e) {}
    if (t !== "dark" && t !== "light") {
      t = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    }
    document.documentElement.setAttribute("data-theme", t);
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root, [data-theme="dark"] {
    --bg:#111111; --card:#1A1A1A; --sub:#0D0D0D; --teal:#5BFFE6; --text:#FFFFFF; --soft:#F5F5F5;
    --grey:#888888; --border:#2A2A2A; --border2:#3A3A3A; --icon-github:#FFFFFF; --icon-hf:#FFD21E;
    --venue-neurips:#A789B6; --venue-iclr:#58C9ED; --venue-icml:#F79011; --venue-preprint:#9A9A9A;
    --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#008300; --s7:#9085e9; --s8:#e66767; --s-other:#8A8A8A;
    color-scheme: dark;
  }
  [data-theme="light"] {
    --bg:#FAFAF8; --card:#FFFFFF; --sub:#F1F1EE; --teal:#00766B; --text:#141414; --soft:#2B2B2B;
    --grey:#6B6B6B; --border:#E4E4E0; --border2:#D4D4D0; --icon-github:#181717; --icon-hf:#FFD21E;
    --venue-neurips:#68448B; --venue-iclr:#0F6F8D; --venue-icml:#985605; --venue-preprint:#6B6B6B;
    --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --s5:#e87ba4; --s6:#008300; --s7:#6250d6; --s8:#e34948; --s-other:#8A8A8A;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: "Hind", system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.5; -webkit-font-smoothing: antialiased; }
  a { color: var(--teal); text-decoration: none; }
  a:hover { text-decoration: underline; }
  :focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
  .icon { width: 15px; height: 15px; flex: none; }
  .tag { color: var(--teal); font-size: 11px; font-weight: 600; letter-spacing: .14em; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .site-header { border-bottom: 1px solid var(--border); }
  .site-header .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px; padding-top: 16px; padding-bottom: 16px; }
  .brand { display: flex; align-items: center; min-height: 44px; }
  .brand svg { height: 26px; width: auto; display: block; fill: var(--text); }
  .header-right { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; }
  .nav { display: flex; flex-wrap: wrap; gap: 4px 24px; font-size: 15px; font-weight: 500; }
  .nav a { color: var(--text); padding: 12px 0; }
  .theme-toggle { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--border2); border-radius: 999px; }
  .theme-toggle button { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: var(--soft); font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; }
  .theme-toggle button[aria-pressed="true"] { background: var(--teal); color: var(--bg); }

  main.wrap { display: flex; flex-direction: column; gap: 72px; padding-top: 72px; padding-bottom: 40px; }
  section { display: flex; flex-direction: column; gap: 20px; }
  .hero { max-width: 760px; }
  .hero .tag { align-self: flex-start; border: 1px solid var(--teal); background: var(--sub); padding: 6px 12px; }
  h1 { margin: 0; font-size: clamp(34px, 5vw, 48px); line-height: 1.1; font-weight: 700; }
  .hero p { margin: 0; font-size: 18px; line-height: 1.55; color: var(--soft); }
  .section-head { display: flex; flex-direction: column; gap: 8px; }
  h2 { margin: 0; font-size: 28px; font-weight: 700; }

  .doc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
  .doc-card { display: flex; flex-direction: column; gap: 10px; min-height: 132px; padding: 20px 22px; background: var(--card); border-top: 2px solid var(--teal); color: var(--text); }
  .doc-card:hover { text-decoration: none; }
  .doc-card:hover .doc-url { text-decoration: underline; }
  .doc-title { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; }
  .doc-title .icon { width: 18px; height: 18px; color: var(--teal); }
  .doc-body { flex-grow: 1; font-size: 14px; color: var(--soft); }
  .doc-url { font-size: 13px; color: var(--teal); }

  .projects-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters[hidden] { display: none; }
  .filters button { min-height: 44px; padding: 0 16px; border: 1px solid var(--border2); background: transparent; color: var(--soft); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; }
  .filters button[aria-pressed="true"] { border-color: var(--teal); background: var(--sub); color: var(--teal); }
  .group { display: flex; flex-direction: column; gap: 16px; }
  .group[hidden] { display: none; }
  .group-head { display: flex; align-items: baseline; gap: 12px; }
  h3 { margin: 0; font-size: 20px; font-weight: 600; }
  .count { font-size: 13px; color: var(--grey); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }

  .card { display: flex; flex-direction: column; gap: 14px; padding: 22px 22px 18px; background: var(--card); border-top: 2px solid var(--teal); }
  .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .card-title { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  h4 { margin: 0; font-size: 18px; font-weight: 700; }
  .repo { font-size: 13px; color: var(--grey); }
  .stars { display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--soft); white-space: nowrap; }
  .stars .icon { width: 14px; height: 14px; color: var(--grey); }
  .stars .src { min-width: 28px; font-size: 11px; font-weight: 600; letter-spacing: .04em; color: var(--grey); }
  .stats { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .desc { flex-grow: 1; margin: 0; font-size: 14px; line-height: 1.55; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .venue { display: inline-flex; align-items: center; padding: 2px 9px; border: 1px solid currentColor; border-radius: 10px; font-size: 12px; font-weight: 600; white-space: nowrap; }
  .venue-neurips { color: var(--venue-neurips); }
  .venue-iclr { color: var(--venue-iclr); }
  .venue-icml { color: var(--venue-icml); }
  .venue-preprint { color: var(--venue-preprint); }
  .license { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--soft); }
  .license .icon { color: var(--grey); }
  .install-box { display: flex; align-items: center; background: var(--sub); border: 1px solid var(--border); }
  .install { flex: 1; min-width: 0; display: block; overflow-x: auto; white-space: nowrap; padding: 8px 10px; color: var(--teal); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  .copy-btn { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 34px; height: 34px; margin-right: 2px; padding: 0; border: 0; background: transparent; color: var(--grey); cursor: pointer; }
  .copy-btn[hidden] { display: none; }
  .copy-btn:hover { color: var(--teal); }
  .copy-btn .icon { width: 15px; height: 15px; }
  .copy-btn .i-done, .copy-btn.copied .i-copy { display: none; }
  .copy-btn.copied .i-done { display: block; }
  .copy-btn.copied { color: var(--teal); }
  .links { display: flex; flex-wrap: wrap; gap: 2px 18px; padding-top: 10px; border-top: 1px solid var(--border); font-size: 14px; font-weight: 500; }
  .links a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; }
  .links .icon { color: var(--teal); }
  .links .i-github { color: var(--icon-github); }
  .links .i-hf { color: var(--icon-hf); }

  .stat-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .tile { display: flex; flex-direction: column; gap: 4px; padding: 20px 22px; background: var(--card); border-top: 2px solid var(--teal); }
  .tile-value { font-size: 34px; font-weight: 700; line-height: 1.15; }
  .tile-label { font-size: 14px; color: var(--soft); }
  .tile-note { font-size: 13px; color: var(--grey); }
  .chart-panel { display: flex; flex-direction: column; gap: 16px; padding: 22px; background: var(--card); }
  .chart-panel[hidden] { display: none; }
  .chart-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .chart-top h3 { font-size: 18px; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .legend button { display: inline-flex; align-items: center; gap: 8px; min-height: 32px; padding: 0 10px; border: 1px solid var(--border); background: transparent; color: var(--soft); font: inherit; font-size: 13px; cursor: pointer; }
  .legend button[aria-pressed="false"] { color: var(--grey); text-decoration: line-through; }
  .legend button[aria-pressed="false"] .key { opacity: .3; }
  .key { display: inline-block; flex: none; width: 14px; height: 2px; border-radius: 1px; }
  .plot-wrap { position: relative; }
  .plot svg { display: block; width: 100%; overflow: visible; }
  .plot svg:focus-visible { outline-offset: 4px; }
  .chart-tip { position: absolute; z-index: 2; min-width: 170px; padding: 8px 10px; background: var(--sub); border: 1px solid var(--border2); font-size: 13px; pointer-events: none; }
  .chart-tip[hidden] { display: none; }
  .tip-date { margin-bottom: 4px; font-size: 12px; color: var(--grey); }
  .tip-row { display: flex; align-items: center; gap: 8px; line-height: 1.6; }
  .tip-row strong { color: var(--text); font-weight: 700; font-variant-numeric: tabular-nums; }
  .tip-row .name { color: var(--soft); }
  .chart-caption { margin: 0; font-size: 13px; color: var(--grey); }
  .data-table summary { cursor: pointer; font-size: 14px; font-weight: 500; color: var(--teal); }
  .table-scroll { max-height: 340px; margin-top: 10px; overflow: auto; border: 1px solid var(--border); }
  .stats-section { min-width: 0; }
  .stats-section > * { min-width: 0; max-width: 100%; }
  .stats-table-card { overflow-x: auto; background: var(--card); }
  .stats-section table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .stats-section th, .stats-section td { padding: 9px 14px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .stats-section th:first-child, .stats-section td:first-child { text-align: left; }
  .stats-section thead th { position: sticky; top: 0; background: var(--card); color: var(--soft); font-size: 13px; font-weight: 600; }
  .stats-section tbody tr:last-child td { border-bottom: 0; }
  .stats-section td .repo, .stats-section td .sub { display: block; font-size: 12px; color: var(--grey); }
  .stats-section .na { color: var(--grey); }

  .site-footer { margin-top: 32px; border-top: 1px solid var(--border); }
  .site-footer .wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; padding-top: 40px; padding-bottom: 48px; }
  .site-footer .col { display: flex; flex-direction: column; gap: 8px; }
  .site-footer p { margin: 0; font-size: 14px; color: var(--soft); }
  .site-footer .col-links { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
  .site-footer .small { font-size: 12px; color: var(--grey); }

  @media (max-width: 600px) {
    .wrap { padding: 0 20px; }
    main.wrap { gap: 56px; padding-top: 48px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
</head>
